DGT_DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/gestinem_dgt
DGT_INTERNAL_API_KEY=generar-un-secreto-largo
DGT_PUBLIC_BASE_URL=https://tramites.gestinem.es
DGT_TOKEN_TTL_HOURS=168
DGT_STORAGE_DIR=/data/documentos
MESSAGING_PUBLIC_BASE_URL=https://tramites.gestinem.es
# Azure Blob es obligatorio en produccion; MESSAGING_STORAGE_DIR solo sirve para desarrollo.
MESSAGING_AZURE_CONNECTION_STRING=
MESSAGING_AZURE_CONTAINER=mensajeria-temporal
MESSAGING_STORAGE_DIR=/data/mensajeria-temporal
MESSAGING_ATTACHMENT_DAYS=30
MESSAGING_LATEST_APP_VERSION=0.1.1
MESSAGING_LATEST_APP_BUILD=11
MESSAGING_MINIMUM_APP_BUILD=1
# Canal principal: Microsoft Graph con permiso de aplicacion Mail.Send.
MESSAGING_GRAPH_TENANT_ID=
MESSAGING_GRAPH_CLIENT_ID=
MESSAGING_GRAPH_CLIENT_SECRET=
MESSAGING_GRAPH_FROM=Oficina@gestinem.es
# Respaldo opcional si Graph no esta configurado.
MESSAGING_SMTP_HOST=
MESSAGING_SMTP_PORT=587
MESSAGING_SMTP_USER=
MESSAGING_SMTP_PASSWORD=
MESSAGING_SMTP_FROM=Oficina@gestinem.es
MESSAGING_SMTP_USE_TLS=true
# Cuenta de servicio Firebase Admin montada fuera del repositorio.
MESSAGING_FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json
# En Railway usar esta alternativa como variable secreta con el JSON completo.
MESSAGING_FIREBASE_CREDENTIALS_JSON=
MESSAGING_APP_REDIRECT_URI=es.gestinem.app://auth/callback
# Azure Document Intelligence (OCR de facturas recibidas)
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=
AZURE_DOC_INTELLIGENCE_MODEL_ID=prebuilt-invoice
# Azure Blob Storage para entrenamiento OCR
AZURE_OCR_TRAINING_CONNECTION_STRING=
AZURE_OCR_TRAINING_CONTAINER=facturas-entrenamiento
